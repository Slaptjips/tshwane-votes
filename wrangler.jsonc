// Cloudflare Workers static-assets deploy. Cloudflare's GitHub integration runs `npx wrangler deploy`
// on every push to main (including the live-results commits), publishing docs/ as the site.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "tshwane-votes",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./docs"
  }
}
